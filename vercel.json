{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node scripts/build-blog.js",
  "outputDirectory": ".",
  "regions": ["icn1"],
  "github": { "silent": true },
  "functions": {
    "api/expos.js": {
      "maxDuration": 30
    },
    "api/admin/page.js": {
      "includeFiles": "api/_lib/admin-page.html"
    },
    "api/admin/posts.js": {
      "maxDuration": 60
    },
    "api/admin/fill-photos.js": {
      "maxDuration": 60
    },
    "api/fill-photos-auto.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/blog/wedding-expo-checklist", "destination": "/blog/1", "permanent": true },
    { "source": "/gwangju", "destination": "/blog/15", "permanent": true }
  ],
  "rewrites": [
    { "source": "/admin/:key", "destination": "/api/admin/page?key=:key" }
  ],
  "headers": [
    {
      "source": "/expos.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
